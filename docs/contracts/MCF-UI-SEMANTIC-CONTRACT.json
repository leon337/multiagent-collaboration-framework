  "workflows": [
    {
      "id": "chatgpt.open-project",
      "parameters": [
        "projectSemanticId"
      ],
      "steps": [
        "resolve projectSemanticId",
        "require exactly one candidate",
        "revalidate identity",
        "activate",
        "validate current-project.matches-local-binding"
      ]
    },
    {
      "id": "chatgpt.start-fresh-chat-in-project",
      "parameters": [
        "projectSemanticId"
      ],
      "steps": [
        "chatgpt.open-project",
        "resolve chatgpt.action.new-chat",
        "require exactly one candidate",
        "activate",
        "validate conversation.changed-or-fresh",
        "validate chatgpt.composer.primary"
      ]
    },
    {
      "id": "chatgpt.send-message",
      "steps": [
        "validate current conversation and pane",
        "validate chatgpt.composer.primary",
        "type exact payload",
        "resolve chatgpt.composer.submit in send state",
        "activate",
        "validate new user turn / conversation advance"
      ]
    }
  ]

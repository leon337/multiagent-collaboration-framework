      "id": "chatgpt.generation.stop",
      "concept": "Stop active assistant generation",
      "surface": "chatgpt",
      "kind": "action-control",
      "critical": true,
      "preconditions": [
        "generation.active",
        "conversation.current"
      ],
      "locators": [
        {
          "id": "stop-testid",
          "priority": 10,
          "strategy": "testid",
          "values": [
            "stop-button",
            "composer-submit-button"
          ],
          "expectedMatches": 1,
          "requiresState": "generation.active"

    {
      "id": "chatgpt.composer.submit",
      "concept": "Stateful primary composer submit control",
      "surface": "chatgpt",
      "kind": "stateful-action-control",
      "critical": true,
      "preconditions": [
        "composer.present"
      ],
      "locators": [
        {
          "id": "composer-submit-id",
          "priority": 10,
          "strategy": "css-id",
          "value": "#composer-submit-button",
          "expectedMatches": 1
        }
      ],
      "states": [
        "send",
        "stop-generation",
        "unavailable"
      ],
      "ambiguity": "fail",
      "availability": {
        "rule": "may-be-absent-when-composer-empty-and-generation-inactive",
        "validStates": [
          "send",
          "stop-generation",
          "unavailable"
        ]
      },
      "resolutionPolicy": {
        "zeroMatches": "UNAVAILABLE when composer is empty and generation is inactive; otherwise NOT_FOUND",
        "oneMatch": "resolve and classify semantic state",
        "multipleMatches": "AMBIGUOUS"
      },
      "stateClassification": {
        "send": {
          "requires": [
            "generation.inactive",
            "composer.nonempty"
          ],
          "control": [
            "#composer-submit-button"
          ],
          "accessibleNames": {
            "pt-BR": [
              "Enviar prompt",
              "Enviar"
            ],
            "en": [
              "Send prompt",
              "Send"
            ]
          }
        },
        "stop-generation": {
          "requires": [
            "generation.active"
          ],
          "control": [
            "#composer-submit-button"
          ],
          "accessibleNames": {
            "pt-BR": [
              "Parar de responder",
              "Parar de gerar",
              "Interromper resposta"
            ],
            "en": [
              "Stop generating",
              "Stop responding"
            ]
          }
        },
        "unavailable": {
          "requires": [
            "generation.inactive",
            "composer.empty"
          ],
          "matchCount": 0
        },
        "unknown": {
          "outcome": "VALIDATION_FAILED",
          "actionAllowed": false
        }
      }
    },

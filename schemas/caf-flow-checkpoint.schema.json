{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon337/multiagent-collaboration-framework/schemas/caf-flow-checkpoint.schema.json",
  "title": "MCF CAF Flow Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objetivo",
    "estado",
    "ultimo_sucesso",
    "falha_atual",
    "classe_da_falha",
    "efeito_confirmado",
    "recuperacao_escolhida",
    "proxima_acao",
    "destinatario",
    "artefatos"
  ],
  "properties": {
    "objetivo": { "type": "string", "minLength": 1 },
    "parent_mission_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "return_to": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "not": { "const": "ENCERRADO" } }
      ]
    },
    "return_status": {
      "enum": ["NOT_APPLICABLE", "PENDING", "COMPLETED"]
    },
    "estado": {
      "enum": [
        "PLANEJADO",
        "EM_EXECUCAO",
        "SUCESSO_PARCIAL",
        "RECUPERANDO",
        "ENTREGUE",
        "AGUARDANDO_DEPENDENCIA_EXTERNA",
        "BLOQUEADO_POR_RISCO",
        "CANCELADO_PELA_AUTORIDADE",
        "ENCERRADO"
      ]
    },
    "ultimo_sucesso": { "type": "string", "minLength": 1 },
    "falha_atual": { "type": "string", "minLength": 1 },
    "classe_da_falha": {
      "enum": [
        "NENHUMA",
        "RECUPERAVEL",
        "DEGRADADA",
        "BLOQUEANTE_EXTERNA",
        "IRREVERSIVEL_OU_RISCO"
      ]
    },
    "efeito_confirmado": { "type": "string", "minLength": 1 },
    "recuperacao_escolhida": { "type": "string", "minLength": 1 },
    "proxima_acao": { "type": "string", "minLength": 1 },
    "destinatario": {
      "type": "string",
      "minLength": 1,
      "not": { "const": "ENCERRADO" }
    },
    "artefatos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "referencia"],
        "properties": {
          "tipo": {
            "enum": ["arquivo", "commit", "pull_request", "teste", "log", "parecer", "outro"]
          },
          "referencia": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "estado": { "const": "ENCERRADO" } },
        "required": ["estado"]
      },
      "then": {
        "properties": {
          "proxima_acao": { "const": "nenhuma" },
          "falha_atual": { "const": "nenhuma" },
          "classe_da_falha": { "const": "NENHUMA" }
        }
      }
    },
    {
      "if": {
        "properties": { "classe_da_falha": { "const": "NENHUMA" } },
        "required": ["classe_da_falha"]
      },
      "then": {
        "properties": {
          "falha_atual": { "const": "nenhuma" },
          "recuperacao_escolhida": { "const": "nenhuma" }
        }
      }
    },
    {
      "if": {
        "properties": { "parent_mission_id": { "type": "string" } },
        "required": ["parent_mission_id"]
      },
      "then": {
        "required": ["return_to", "return_status"],
        "properties": {
          "return_to": { "type": "string", "minLength": 1, "not": { "const": "ENCERRADO" } },
          "return_status": { "enum": ["PENDING", "COMPLETED"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parent_mission_id": { "type": "string" },
          "estado": { "const": "ENCERRADO" }
        },
        "required": ["parent_mission_id", "estado"]
      },
      "then": {
        "required": ["return_to", "return_status"],
        "properties": { "return_status": { "const": "COMPLETED" } }
      }
    },
    {
      "if": {
        "properties": { "parent_mission_id": { "type": "null" } },
        "required": ["parent_mission_id"]
      },
      "then": {
        "properties": {
          "return_to": { "type": "null" },
          "return_status": { "const": "NOT_APPLICABLE" }
        }
      }
    }
  ]
}

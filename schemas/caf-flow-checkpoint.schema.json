{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon337/multiagent-collaboration-framework/schemas/caf-flow-checkpoint.schema.json",
  "title": "MCF CAF Flow Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objetivo",
    "estado",
    "ultimo_sucesso",
    "falha_atual",
    "classe_da_falha",
    "efeito_confirmado",
    "recuperacao_escolhida",
    "proxima_acao",
    "destinatario",
    "artefatos"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "missionId": {
      "type": "string",
      "minLength": 1
    },
    "methodologyPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "immutableRef"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "immutableRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "alignedPipRef": {
      "$ref": "https://github.com/leon337/multiagent-collaboration-framework/schemas/mcf-artifact-ref.schema.json"
    },
    "missionContractRef": {
      "type": "string",
      "minLength": 1
    },
    "projectRealityReportRef": {
      "$ref": "https://github.com/leon337/multiagent-collaboration-framework/schemas/mcf-artifact-ref.schema.json"
    },
    "pendingHumanGates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activeStandingAuthorizationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repositoryState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "checkpointSha",
        "capturedAt",
        "volatile"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "checkpointSha": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "volatile": {
          "const": true
        }
      }
    },
    "resumeRouteHint": {
      "enum": ["FAST_RESUME", "RECONCILE", "RECOVER_MCF_PROJECT"]
    },
    "transferability": {
      "enum": ["TRANSFERABLE", "BLOCKED_LOCAL_ONLY_STATE"]
    },
    "objetivo": {
      "type": "string",
      "minLength": 1
    },
    "estado": {
      "enum": [
        "PLANEJADO",
        "EM_EXECUCAO",
        "SUCESSO_PARCIAL",
        "RECUPERANDO",
        "ENTREGUE",
        "AGUARDANDO_DEPENDENCIA_EXTERNA",
        "BLOQUEADO_POR_RISCO",
        "CANCELADO_PELA_AUTORIDADE",
        "ENCERRADO"
      ]
    },
    "ultimo_sucesso": {
      "type": "string",
      "minLength": 1
    },
    "falha_atual": {
      "type": "string",
      "minLength": 1
    },
    "classe_da_falha": {
      "enum": [
        "NENHUMA",
        "RECUPERAVEL",
        "DEGRADADA",
        "BLOQUEANTE_EXTERNA",
        "IRREVERSIVEL_OU_RISCO"
      ]
    },
    "efeito_confirmado": {
      "type": "string",
      "minLength": 1
    },
    "recuperacao_escolhida": {
      "type": "string",
      "minLength": 1
    },
    "proxima_acao": {
      "type": "string",
      "minLength": 1
    },
    "destinatario": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "ENCERRADO"
      }
    },
    "artefatos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "referencia"],
        "properties": {
          "tipo": {
            "enum": [
              "arquivo",
              "commit",
              "pull_request",
              "teste",
              "log",
              "parecer",
              "outro"
            ]
          },
          "referencia": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "estado": {
            "const": "ENCERRADO"
          }
        },
        "required": ["estado"]
      },
      "then": {
        "properties": {
          "proxima_acao": {
            "const": "nenhuma"
          },
          "falha_atual": {
            "const": "nenhuma"
          },
          "classe_da_falha": {
            "const": "NENHUMA"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classe_da_falha": {
            "const": "NENHUMA"
          }
        },
        "required": ["classe_da_falha"]
      },
      "then": {
        "properties": {
          "falha_atual": {
            "const": "nenhuma"
          },
          "recuperacao_escolhida": {
            "const": "nenhuma"
          }
        }
      }
    }
  ]
}

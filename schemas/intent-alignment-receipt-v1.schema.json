{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon337/multiagent-collaboration-framework/schemas/intent-alignment-receipt-v1.schema.json",
  "title": "MCF Intent Alignment Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "schemaVersion",
    "receiptId",
    "projectId",
    "pipRef",
    "decision",
    "humanAuthority",
    "confirmedAt",
    "confirmationSourceRef",
    "contentDigest"
  ],
  "properties": {
    "artifactType": { "const": "INTENT_ALIGNMENT_RECEIPT" },
    "schemaVersion": { "const": "1.0" },
    "receiptId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "pipRef": {
      "allOf": [
        {
          "$ref": "https://github.com/leon337/multiagent-collaboration-framework/schemas/mcf-artifact-ref.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "artifactType": { "const": "PROJECT_INTENT_PACKAGE" },
            "schemaVersion": { "const": "1.0" }
          }
        }
      ]
    },
    "decision": { "enum": ["PASS", "REJECTED_FOR_CORRECTION"] },
    "humanAuthority": { "const": "LEANDRO" },
    "confirmedAt": { "type": "string", "format": "date-time" },
    "confirmationSourceRef": { "type": "string", "minLength": 1 },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

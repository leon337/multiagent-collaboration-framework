{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon337/multiagent-collaboration-framework/schemas/mcf-artifact-ref.schema.json",
  "title": "MCF Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "schemaVersion",
    "projectId",
    "revisionId",
    "path",
    "contentDigest",
    "repository",
    "commitSha"
  ],
  "properties": {
    "artifactType": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^\\.mcf/", "minLength": 1 },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repository": { "type": "string", "minLength": 1 },
    "commitSha": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        { "type": "null" }
      ]
    }
  }
}

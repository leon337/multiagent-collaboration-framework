{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon337/multiagent-collaboration-framework/schemas/context/project-capsule.schema.json",
  "title": "MCF Project Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "purpose",
    "lifecycle",
    "snapshot",
    "sources",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "lifecycle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_workstream",
        "current_status",
        "next_action",
        "blockers"
      ],
      "properties": {
        "current_workstream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "current_status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "next_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "blockers": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state"],
      "properties": {
        "current_state": { "$ref": "#/$defs/repository_path" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F\\u007F])(?=.*\\S)[^/]+(?:/[^/]+)*$"
    }
  }
}

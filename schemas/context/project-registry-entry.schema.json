{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon337/multiagent-collaboration-framework/schemas/context/project-registry-entry.schema.json",
  "title": "MCF Project Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "identity",
    "ownership",
    "context",
    "freshness"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lifecycle"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "lifecycle": {
          "enum": [
            "DISCOVERABLE",
            "CANDIDATE",
            "REGISTERED",
            "SUSPENDED",
            "ARCHIVED"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_repository", "aliases"],
      "properties": {
        "canonical_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 256
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_owner"],
      "properties": {
        "project_owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capsule_path", "canonical_entrypoints"],
      "properties": {
        "capsule_path": { "$ref": "#/$defs/repository_path" },
        "canonical_entrypoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repository_path" }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operational_state", "project_identity"],
      "properties": {
        "operational_state": { "const": "LIVE_REQUIRED" },
        "project_identity": { "const": "DURABLE" }
      }
    }
  },
  "$defs": {
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F\\u007F])(?=.*\\S)[^/]+(?:/[^/]+)*$"
    }
  }
}

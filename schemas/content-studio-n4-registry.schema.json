{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcf.local/schemas/content-studio-n4-registry.schema.json",
  "title": "MCF Content Studio N4 Registry",
  "type": "object",
  "required": [
    "registryVersion",
    "components",
    "templates"
  ],
  "additionalProperties": false,
  "properties": {
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "aspect": {
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "status": {
      "enum": [
        "DISCOVERED",
        "REVIEWED",
        "ADAPTED",
        "APPROVED",
        "DEPRECATED"
      ]
    },
    "complexity": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "version",
        "category",
        "pedagogicalPurpose",
        "supportedAspects",
        "defaultProps",
        "editableProps",
        "duration",
        "safeArea",
        "reducedMotion",
        "origin",
        "license",
        "dependencies",
        "status",
        "supportsAudioSync",
        "complexity",
        "tags",
        "intents"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "category": {
          "enum": [
            "concept",
            "diagram",
            "timeline",
            "learning",
            "architecture",
            "progress",
            "ui",
            "code",
            "media",
            "motion",
            "typography",
            "layout",
            "fx"
          ]
        },
        "pedagogicalPurpose": {
          "type": "string",
          "minLength": 1
        },
        "supportedAspects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/aspect"
          }
        },
        "defaultProps": {
          "type": "object"
        },
        "editableProps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "duration": {
          "type": "object",
          "required": [
            "minFrames",
            "recommendedFrames"
          ],
          "additionalProperties": false,
          "properties": {
            "minFrames": {
              "type": "integer",
              "minimum": 1
            },
            "recommendedFrames": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "safeArea": {
          "enum": [
            "required",
            "decorative-only"
          ]
        },
        "reducedMotion": {
          "enum": [
            "supported",
            "not-applicable"
          ]
        },
        "origin": {
          "type": "object",
          "required": [
            "kind",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "mcf",
                "external"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "license": {
          "type": "object",
          "required": [
            "id",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "supportsAudioSync": {
          "type": "boolean"
        },
        "complexity": {
          "$ref": "#/$defs/complexity"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "version",
        "purpose",
        "supportedAspects",
        "componentIds",
        "slots",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "supportedAspects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/aspect"
          }
        },
        "componentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "accepts",
              "required"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "accepts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  }
}

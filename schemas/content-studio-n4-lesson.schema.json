{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcf.local/schemas/content-studio-n4-lesson.schema.json",
  "title": "MCF Technical Lesson N4 Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lesson",
    "chapters",
    "scenes",
    "narration",
    "visuals",
    "theme",
    "assets",
    "timings"
  ],
  "properties": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentId",
          "durationFrames",
          "props"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "durationFrames": {
            "type": "integer",
            "minimum": 1
          },
          "props": {
            "type": "object"
          },
          "motionPreset": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "layout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": -0.45,
                "maximum": 0.45
              },
              "y": {
                "type": "number",
                "minimum": -0.45,
                "maximum": 0.45
              },
              "scale": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 1.5
              },
              "rotationDeg": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "snap": {
                "type": "boolean"
              }
            }
          },
          "focusIntent": {
            "enum": [
              "model",
              "relation",
              "sequence",
              "metric",
              "text-entry"
            ]
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cues"
      ],
      "properties": {
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "text"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "visuals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect",
        "reducedMotion"
      ],
      "properties": {
        "aspect": {
          "enum": [
            "9:16",
            "16:9"
          ]
        },
        "reducedMotion": {
          "type": "boolean"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "background",
        "accent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps"
      ],
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    }
  }
}

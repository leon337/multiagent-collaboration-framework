{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon337/multiagent-collaboration-framework/schemas/project-intent-package-v1.schema.json",
  "title": "MCF Project Intent Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "schemaVersion",
    "projectId",
    "revisionId",
    "lifecycle",
    "methodologyPin",
    "createdAt",
    "identity",
    "originalIntent",
    "dimensions",
    "humanDecisions",
    "technicalDelegations",
    "assumptions",
    "unknowns",
    "blockers",
    "conflicts",
    "readiness",
    "alignment",
    "contentDigest"
  ],
  "properties": {
    "artifactType": { "const": "PROJECT_INTENT_PACKAGE" },
    "schemaVersion": { "const": "1.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "enum": [
        "DISCOVERY_IN_PROGRESS",
        "READY_FOR_ALIGNMENT",
        "ALIGNED",
        "REOPENED_AFTER_MATERIAL_CHANGE"
      ]
    },
    "methodologyPin": { "$ref": "#/$defs/methodologyPin" },
    "createdAt": { "type": "string", "format": "date-time" },
    "supersedesRevisionId": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectName": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "originalIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "provenance"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenanceRef" }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PROBLEM",
        "MOTIVATION",
        "DESIRED_OUTCOME",
        "TARGET_USERS",
        "CRITICAL_USER_JOURNEYS",
        "MUST_HAVE",
        "SHOULD_HAVE",
        "NON_GOALS",
        "PRIORITIES_AND_TRADEOFFS",
        "BUSINESS_RULES",
        "DATA_AND_SENSITIVITY",
        "ROLES_AND_PERMISSIONS",
        "AUTOMATION_LEVEL",
        "INTEGRATIONS",
        "PLATFORM_AND_USAGE_CONTEXT",
        "COST_AND_RESOURCE_CONSTRAINTS",
        "QUALITY_EXPECTATIONS",
        "FAILURE_TOLERANCE",
        "DEFINITION_OF_DONE",
        "FUTURE_VISION"
      ],
      "properties": {
        "PROBLEM": { "$ref": "#/$defs/dimensionRecord" },
        "MOTIVATION": { "$ref": "#/$defs/dimensionRecord" },
        "DESIRED_OUTCOME": { "$ref": "#/$defs/dimensionRecord" },
        "TARGET_USERS": { "$ref": "#/$defs/dimensionRecord" },
        "CRITICAL_USER_JOURNEYS": { "$ref": "#/$defs/dimensionRecord" },
        "MUST_HAVE": { "$ref": "#/$defs/dimensionRecord" },
        "SHOULD_HAVE": { "$ref": "#/$defs/dimensionRecord" },
        "NON_GOALS": { "$ref": "#/$defs/dimensionRecord" },
        "PRIORITIES_AND_TRADEOFFS": { "$ref": "#/$defs/dimensionRecord" },
        "BUSINESS_RULES": { "$ref": "#/$defs/dimensionRecord" },
        "DATA_AND_SENSITIVITY": { "$ref": "#/$defs/dimensionRecord" },
        "ROLES_AND_PERMISSIONS": { "$ref": "#/$defs/dimensionRecord" },
        "AUTOMATION_LEVEL": { "$ref": "#/$defs/dimensionRecord" },
        "INTEGRATIONS": { "$ref": "#/$defs/dimensionRecord" },
        "PLATFORM_AND_USAGE_CONTEXT": { "$ref": "#/$defs/dimensionRecord" },
        "COST_AND_RESOURCE_CONSTRAINTS": { "$ref": "#/$defs/dimensionRecord" },
        "QUALITY_EXPECTATIONS": { "$ref": "#/$defs/dimensionRecord" },
        "FAILURE_TOLERANCE": { "$ref": "#/$defs/dimensionRecord" },
        "DEFINITION_OF_DONE": { "$ref": "#/$defs/dimensionRecord" },
        "FUTURE_VISION": { "$ref": "#/$defs/dimensionRecord" }
      }
    },
    "humanDecisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/humanDecision" }
    },
    "technicalDelegations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["delegationId", "domain", "scope", "provenance"],
        "properties": {
          "delegationId": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "provenance": {
            "type": "array",
            "items": { "$ref": "#/$defs/provenanceRef" }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "provenance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "provenance": {
            "type": "array",
            "items": { "$ref": "#/$defs/provenanceRef" }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "blocking"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/idStatement" }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "sourceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockingUnknownIds", "assessedAt"],
      "properties": {
        "state": {
          "enum": ["NOT_READY", "CONDITIONALLY_READY", "READY_FOR_ALIGNMENT"]
        },
        "blockingUnknownIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "assessedAt": { "type": "string", "format": "date-time" }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["NOT_ALIGNED", "ALIGNED", "REOPENED"] },
        "receiptRef": { "type": "string", "minLength": 1 },
        "alignedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "methodologyPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "immutableRef"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "immutableRef": { "type": "string", "minLength": 1 }
      }
    },
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sourceRef", "capturedAt", "actor"],
      "properties": {
        "type": {
          "enum": [
            "HUMAN_DIRECT_STATEMENT",
            "HUMAN_CONFIRMED_SYNTHESIS",
            "PRIOR_VALID_HUMAN_DECISION",
            "MACHINE_EVIDENCE",
            "MACHINE_INFERENCE",
            "TECHNICAL_DELEGATION",
            "NOT_APPLICABLE_JUSTIFICATION"
          ]
        },
        "sourceRef": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 }
      }
    },
    "dimensionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "provenance", "readinessImpact"],
      "properties": {
        "state": {
          "enum": [
            "CLEAR",
            "PARTIAL",
            "UNKNOWN",
            "CONFLICTING",
            "NOT_APPLICABLE"
          ]
        },
        "value": true,
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenanceRef" }
        },
        "readinessImpact": { "enum": ["BLOCKING", "NON_BLOCKING", "NONE"] },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "humanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "status", "statement", "provenance"],
      "properties": {
        "decisionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["CURRENT", "SUPERSEDED"] },
        "statement": { "type": "string", "minLength": 1 },
        "supersedesDecisionId": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenanceRef" },
          "contains": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": [
                  "HUMAN_DIRECT_STATEMENT",
                  "HUMAN_CONFIRMED_SYNTHESIS",
                  "PRIOR_VALID_HUMAN_DECISION"
                ]
              }
            }
          },
          "minContains": 1
        }
      }
    },
    "idStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    }
  }
}

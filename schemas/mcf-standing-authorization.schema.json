{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon337/multiagent-collaboration-framework/schemas/mcf-standing-authorization.schema.json",
  "title": "MCF Standing Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorizationId",
    "projectId",
    "grantedBy",
    "grantedAt",
    "actionClasses",
    "environments",
    "maximumCost",
    "reversibleOnly",
    "exclusions",
    "evidenceRequirements",
    "sourceDecisionRef",
    "status"
  ],
  "properties": {
    "authorizationId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "missionId": { "type": "string", "minLength": 1 },
    "grantedBy": { "const": "LEANDRO" },
    "grantedAt": { "type": "string", "format": "date-time" },
    "actionClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "not": { "const": "*" } }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "not": { "const": "*" } }
    },
    "maximumCost": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "amount"],
          "properties": {
            "currency": { "type": "string", "minLength": 1 },
            "amount": { "type": "number", "minimum": 0 },
            "period": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "reversibleOnly": { "type": "boolean" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "boundary": { "type": "string", "minLength": 1 },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceRequirements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceDecisionRef": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ACTIVE", "EXPIRED", "REVOKED"] }
  }
}

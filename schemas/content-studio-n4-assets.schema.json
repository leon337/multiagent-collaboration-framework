{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcf.local/schemas/content-studio-n4-assets.schema.json",
  "title": "MCF Content Studio N4 Asset Registry",
  "type": "object",
  "required": [
    "registryVersion",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dedupeKey",
        "version",
        "type",
        "style",
        "orientation",
        "theme",
        "usage",
        "source",
        "license",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "type": {
          "enum": [
            "illustration",
            "icon",
            "mockup",
            "background",
            "texture",
            "video",
            "screenshot",
            "logo",
            "sound",
            "music",
            "diagram",
            "avatar"
          ]
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape",
            "square",
            "any"
          ]
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "mcf",
                "external",
                "procedural"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "generator": {
              "type": "string",
              "minLength": 1
            },
            "params": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "procedural"
                  }
                }
              },
              "then": {
                "required": [
                  "generator",
                  "path"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "mcf",
                      "external"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "path"
                ]
              }
            }
          ]
        },
        "license": {
          "type": "object",
          "required": [
            "id",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "status": {
          "enum": [
            "APPROVED",
            "DEPRECATED"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "dedupeKey": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}

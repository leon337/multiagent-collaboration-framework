NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://rsa:rsa@localhost:5432/rsa
MIGRATION_DATABASE_URL=postgresql://rsa:rsa@localhost:5432/rsa
LOG_LEVEL=info
TRUST_PROXY=false
BODY_LIMIT_BYTES=262144
RATE_LIMIT_KEY_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Dedicated ingress guard for optional lab-only MCF Context registry/recovery GET boundaries.
MCF_CONTEXT_READ_TOKEN=replace-with-a-distinct-read-only-token-at-least-32-characters
# Registry/recovery GET configuration; this boundary stays disabled when empty.
MCF_CONTEXT_CONFIG_JSON=
# Every optional adapter credential below must be distinct from the Context/TriView token and from
# every other adapter credential. Reusing any one of them disables the affected boundary.
# Dedicated Cloud ingress token. It is accepted only in x-mcf-cloud-context-token.
MCF_CLOUD_CONTEXT_INGRESS_TOKEN=replace-with-a-separate-cloud-read-token-at-least-32-characters
# Strict local G2-A config: exact canonical Cloud root, canonical Python executable and SHA-256
# allowlists for that executable plus all 16 owned files (13 provider provenance sources and three
# Python execution dependencies). Missing/invalid means disabled.
MCF_CLOUD_CONTEXT_READ_CONFIG_JSON=
# Optional Cognitive Ledger POST read-query boundary. It stays disabled unless all
# values are valid. The ingress token is accepted only in x-mcf-ledger-read-token.
MCF_COGNITIVE_LEDGER_INGRESS_TOKEN=replace-with-a-dedicated-ledger-ingress-token-at-least-32-characters
MCF_COGNITIVE_LEDGER_MCP_URL=http://127.0.0.1:33100/mcp
MCF_COGNITIVE_LEDGER_BEARER_TOKEN=replace-with-a-distinct-ledger-oauth-bearer-token
# Optional bounded overrides: 250..15000 ms, 1024..32768 bytes, 4096..1048576 bytes.
MCF_COGNITIVE_LEDGER_TIMEOUT_MS=5000
MCF_COGNITIVE_LEDGER_INPUT_LIMIT_BYTES=32768
MCF_COGNITIVE_LEDGER_RESPONSE_LIMIT_BYTES=262144
MCF_COGNITIVE_LEDGER_MAX_CONCURRENT_QUERIES=4

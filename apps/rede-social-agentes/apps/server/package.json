{
  "name": "@rsa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --reporter=default --reporter=json --outputFile=test-results/vitest.json",
    "test:ledger:real:lab": "node e2e/cognitive-ledger-real-lab.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:bootstrap": "node dist/bootstrap-main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@nestjs/common": "11.2.4",
    "@nestjs/core": "11.2.4",
    "@nestjs/platform-fastify": "11.2.4",
    "@rsa/contracts": "workspace:*",
    "@rsa/database": "workspace:*",
    "ajv": "8.20.0",
    "fastify": "5.12.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.8.3",
    "zod": "4.4.3",
    "jose": "6.2.10"
  },
  "devDependencies": {}
}

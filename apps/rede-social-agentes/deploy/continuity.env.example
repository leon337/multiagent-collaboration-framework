# Use a locally built image ID for the first canary, then pin the published
# image by sha256 digest. Never use :latest for the persistent worker.
MCF_WORKER_IMAGE=mcf-continuity-worker@sha256:<64-hex-digest>

# PostgreSQL is the canonical mission state. Store the real file as 0640 and do
# not commit it. TLS is required when PostgreSQL is not on the same trusted host.
MCF_DATABASE_URL=postgresql://mcf_worker:<password>@127.0.0.1:5432/rsa?sslmode=require

MCF_WORKER_ID=mcf-vps-worker-01
MCF_LOG_LEVEL=info
MCF_LEASE_DURATION_MS=60000
MCF_HEARTBEAT_INTERVAL_MS=15000
MCF_POLL_INTERVAL_MS=2000
MCF_STEP_TIMEOUT_MS=2700000

# These paths are prepared by the root-owned bootstrap. The service account is
# UID/GID 1901; the policy stays root-owned and read-only.
MCF_POLICY_FILE=/etc/mcf-continuity/policy.json
MCF_REPOSITORY_ROOT=/var/lib/mcf-continuity/repositories
MCF_CODEX_HOME_DIR=/var/lib/mcf-continuity/codex-home
MCF_WORKTREE_DIR=/var/lib/mcf-continuity/worktrees
MCF_ARTIFACT_DIR=/var/lib/mcf-continuity/artifacts
MCF_CHECKPOINT_DIR=/var/lib/mcf-continuity/checkpoints

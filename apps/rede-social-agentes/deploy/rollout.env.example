# Images must be immutable digest references produced by the candidate publish workflow.
RSA_SERVER_IMAGE=ghcr.io/leon337/rsa-server@sha256:<64-hex-digest>
RSA_WEB_IMAGE=ghcr.io/leon337/rsa-web@sha256:<64-hex-digest>

# External PostgreSQL only. Require TLS in the release gate.
DATABASE_URL=postgresql://user:password@db.example.net:5432/rsa?sslmode=require
RATE_LIMIT_KEY_SECRET=<at-least-32-random-characters>
LOG_LEVEL=info
MAX_BODY_BYTES=262144

# Public entry point is terminated by the external TLS ingress.
PUBLIC_BASE_URL=https://agents.example.net
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8080

# Material release evidence.
BACKUP_EXTERNAL_LOCATION=s3://rsa-backups/production
ALERT_CHANNEL_ID=ops-critical
RESTORE_TEST_EVIDENCE=restore-YYYY-MM-DD-pass
RESTORE_TEST_AT=2026-08-03T00:00:00.000Z
CANARY_PERCENT=5
RELEASE_SHA=<40-hex-main-commit>
ROLLBACK_RELEASE_SHA=<40-hex-previous-release>
ROLLBACK_PLAN_REFERENCE=docs/runbooks/RSA-ROLLBACK.md
ROLLOUT_CONFIRMATION=CANARY_ONLY

PUBLIC_BASE_URL=https://mcf-google-photos-bridge.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_STATE_SECRET=replace-with-long-random-secret
PORT=3000

# MCP OAuth 2.1 resource-server protection.
# Keep disabled in staging until a compatible authorization server is configured.
MCP_AUTH_ENABLED=false
MCP_AUTH_ISSUER=
MCP_AUTH_AUDIENCE=https://mcf-google-photos-bridge.onrender.com/mcp
MCP_AUTH_SCOPES=photos.read
MCP_AUTH_JWKS_URI=
MCP_AUTH_RESOURCE_METADATA_URL=https://mcf-google-photos-bridge.onrender.com/.well-known/oauth-protected-resource/mcp
